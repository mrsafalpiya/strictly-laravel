# Larastan, strict-rules and type-coverage are registered via phpstan/extension-installer.
includes:
    - phar://phpstan.phar/conf/bleedingEdge.neon

parameters:
    level: max
    paths:
        - app/
        - bootstrap/app.php
        - database/
        - routes/
        - tests/

    # Read model casts from the casts() method (Laravel 11+ style); otherwise enums/dates are typed as string.
    parseModelCastsMethod: true

    ignoreErrors:
        # laravel-data's Cast interface takes a raw generic CreationContext; implementations can't name its type.
        - identifier: missingType.generics
          path: app/Support/Data/DateOnlyCast.php

    strictRules:
        # Eloquent builders forward static calls dynamically (User::where(...)); false positives.
        dynamicCallOnStaticMethod: false

    type_coverage:
        return: 100
        param: 100
        property: 100
        constant: 100
        declare: 0
