{
    "name": "mrsafalpiya/strictly-laravel-monorepo",
    "description": "Development tooling for the Strictly Laravel monorepo (not published).",
    "type": "project",
    "license": "MIT",
    "require-dev": {
        "laravel/installer": "^5.32",
        "laravel/pint": "^1.32",
        "nette/neon": "^3.4",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^13.4",
        "spatie/laravel-data": "^4.23"
    },
    "autoload-dev": {
        "psr-4": {
            "StrictlyLaravel\\": "packages/laravel/src/",
            "StrictlyLaravel\\Tests\\": "packages/laravel/tests/"
        },
        "classmap": [
            "packages/laravel/tests/PHPStan/data/",
            "packages/laravel/tests/PHPStan/stubs/"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
