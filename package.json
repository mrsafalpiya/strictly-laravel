{
    "name": "strictly-laravel-monorepo",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.6.0",
    "engines": {
        "node": ">=26"
    },
    "scripts": {
        "harness": "node harness/src/cli.ts",
        "test": "node harness/src/test.ts",
        "typecheck": "tsc -p harness",
        "lint:php": "vendor/bin/pint packages/laravel",
        "test:php": "vendor/bin/phpunit",
        "analyse:php": "vendor/bin/phpstan analyse --memory-limit=2G"
    },
    "devDependencies": {
        "@oxlint/plugins": "1.79.0",
        "@types/node": "^26.6.5",
        "oxlint": "1.79.0",
        "typescript": "^7.0.2",
        "vite": "^8.3.4"
    }
}
