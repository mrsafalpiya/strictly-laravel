{
    "name": "@mrsafalpiya/strictly-laravel",
    "version": "0.1.0",
    "description": "Strictly Laravel: end-to-end type safety for Laravel + Inertia + React (npm side of the Overlay).",
    "license": "MIT",
    "type": "module",
    "exports": {
        ".": {
            "types": "./index.d.ts",
            "default": "./index.js"
        },
        "./contracts": {
            "types": "./contracts/index.d.ts"
        },
        "./echo": {
            "types": "./echo/index.d.ts",
            "default": "./echo/index.js"
        },
        "./jsx/jsx-runtime": {
            "types": "./jsx/jsx-runtime.d.ts"
        },
        "./jsx/jsx-dev-runtime": {
            "types": "./jsx/jsx-dev-runtime.d.ts"
        },
        "./oxlint": "./oxlint/index.js",
        "./react": {
            "types": "./react/index.d.ts",
            "default": "./react/index.js"
        },
        "./routes": {
            "types": "./routes/index.d.ts",
            "default": "./routes/index.js"
        },
        "./translations": {
            "types": "./translations/index.d.ts",
            "default": "./translations/index.js"
        },
        "./vite": {
            "types": "./vite/index.d.ts",
            "default": "./vite/index.js"
        }
    },
    "files": [
        "index.js",
        "index.d.ts",
        "contracts",
        "echo",
        "jsx",
        "oxlint",
        "react",
        "routes",
        "translations",
        "vite"
    ],
    "peerDependencies": {
        "@inertiajs/core": "^3.0.0",
        "@inertiajs/react": "^3.0.0",
        "@laravel/echo-react": "^2.6.0",
        "react": "^19.2.0",
        "vite": ">=8"
    },
    "peerDependenciesMeta": {
        "@laravel/echo-react": {
            "optional": true
        }
    },
    "devDependencies": {
        "@inertiajs/core": "^3.9.1",
        "@inertiajs/react": "^3.9.1",
        "@laravel/echo-react": "^2.6.1",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "pusher-js": "^8.6.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0"
    },
    "sideEffects": false
}
