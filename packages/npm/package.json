{
    "name": "@mrsafalpiya/strictly-laravel",
    "version": "0.1.0",
    "description": "Strictly Laravel: end-to-end type safety for Laravel + Inertia + React (npm side of the Overlay).",
    "license": "MIT",
    "type": "module",
